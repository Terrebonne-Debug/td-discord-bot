# Discord bot credentials
DISCORD_TOKEN=your_discord_bot_token

# DeepSeek credentials (use the same DeepSeek key as your Claude Code setup)
DEEPSEEK_API_KEY=your_deepseek_api_key

# DeepSeek API settings. These defaults mirror the Claude Code session:
# Anthropic-compatible endpoint, deepseek-v4-flash, thinking enabled, effort max.
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=enabled
DEEPSEEK_EFFORT=max
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TIMEOUT_MS=180000

# Optional: 0-2. Leave blank for the API default. Ignored while thinking is enabled.
DEEPSEEK_TEMPERATURE=

# Optional: set a server ID to register slash commands there instantly.
# Leave blank to register global commands (they can take up to an hour to appear).
DISCORD_GUILD_ID=

# Bot behavior
SYSTEM_PROMPT=You are a helpful Discord bot powered by DeepSeek. Answer clearly and concisely, using Markdown that renders well in Discord.
MAX_HISTORY_TURNS=10
MAX_PROMPT_CHARS=4000
