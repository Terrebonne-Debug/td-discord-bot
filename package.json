{
  "name": "td-discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A basic Discord bot backed by the DeepSeek API.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "check": "tsc --noEmit",
    "test": "node --import=./test/helpers/test-env.ts --test 'test/**/*.test.ts'",
    "test:coverage": "node --import=./test/helpers/test-env.ts --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/index.ts' --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "mongodb": "^7.8.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "ws": "^8.22.1"
  }
}
